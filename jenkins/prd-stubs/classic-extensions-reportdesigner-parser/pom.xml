  Compile-time stub for classic-extensions-reportdesigner-parser.

  Full module pulls mondrian + pmd. Slim PRD only needs
  ReportDesignerParserModule string constants for guide-line attributes.
  Not a full runtime replacement for legacy .report XML parsing.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>org.pentaho.reporting.engine</groupId>
  <artifactId>classic-extensions-reportdesigner-parser</artifactId>
  <version>10.1.0.0-SNAPSHOT</version>
  <packaging>jar</packaging>
  <name>classic-extensions-reportdesigner-parser (slim stub)</name>
  <properties>
    <maven.compiler.source>1.8</maven.compiler.source>
    <maven.compiler.target>1.8</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>
</project>
